# Speech: local (default, Chinese Whisper) | doubao | azure
SPEECH_PROVIDER=local
# auto = better for Chinese + English tech terms (Istio, K8s, …)
WHISPER_LANGUAGE=auto
# Bias Whisper toward Simplified Chinese (output is also post-converted via OpenCC)
# WHISPER_INITIAL_PROMPT=以下是简体中文的内容。
# Prefer medium model (download: ./scripts/download-whisper-model.sh medium)
# WHISPER_MODEL_PATH=/absolute/path/to/ggml-medium.bin
# WHISPER_BEAM_SIZE=5
# WHISPER_BEST_OF=5

# Doubao (Volcengine) streaming ASR — when SPEECH_PROVIDER=doubao
# Docs: https://docs.volcengine.com/docs/DoubaoVoice/LargemodelstreamingautomaticspeechrecognitionAPI
# DOUBAO_ASR_API_KEY=your_api_key_here
# DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# DOUBAO_ASR_HOTWORDS=Agent,Kubernetes,Istio,DeepSeek

# LLM: deepseek client (default) | gemini
# Works with official DeepSeek or any OpenAI-compatible /v1/chat/completions proxy.
LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash
# Optional: override key. Otherwise auto-reads ~/.dsh/.credentials.yaml
# DEEPSEEK_API_KEY=sk-your-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Example proxy (use model ids from GET /v1/models, e.g. deepseek-v4.1-flash):
# DEEPSEEK_BASE_URL=https://api.kakouai.com/v1
# DEEPSEEK_MODEL=deepseek-v4.1-flash

# Google Gemini — only when LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Screenshot (⌘⇧S): default = send image to DeepSeek vision (no OCR).
# SCREENSHOT_USE_OCR=1

# Workspace Q&A via deepseek-harness (dsh headless). Also toggle in Settings.
# When enabled + a workspace folder is selected, voice/chat goes through dsh.
# DSH_ENABLED=true
# DSH_HARNESS_DIR=/Users/you/PythonProjects/deepseek-harness
# DSH_BIN=/absolute/path/to/dsh
# DSH_TIMEOUT_MS=300000

# Azure Speech — only when SPEECH_PROVIDER=azure
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here
