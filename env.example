# Speech: local (default, Chinese Whisper) | azure
SPEECH_PROVIDER=local
WHISPER_LANGUAGE=zh
# Optional: custom model path (default: ./models/ggml-small.bin)
# WHISPER_MODEL_PATH=/absolute/path/to/ggml-small.bin
# WHISPER_BIN=whisper-cli

# Google Gemini API (LLM answers) — still required for AI replies
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Azure Speech — only needed when SPEECH_PROVIDER=azure
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here
